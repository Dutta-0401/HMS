# ============================================
# Hospital Booking API - Environment Variables
# ============================================
# IMPORTANT: Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# DATABASE CONFIGURATION (MongoDB Atlas)
# ============================================
# Replace <user>, <password>, <cluster> and <db> with your own Atlas values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_DATABASE=hospitaldb

# ============================================
# JWT CONFIGURATION
# ============================================
# Generate a strong secret using:
# openssl rand -base64 64
# OR use: https://generate-secret.vercel.app/64
JWT_SECRET=your-production-secret-key-min-256-bits-use-openssl-rand-base64-64-to-generate
JWT_EXPIRATION=86400000

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-production-domain.com

# ============================================
# LOGGING CONFIGURATION
# ============================================
# Options: DEBUG, INFO, WARN, ERROR
# Use INFO or WARN for production
LOG_LEVEL=INFO

# ============================================
# SWAGGER/API DOCS
# ============================================
# Disable in production for security
SWAGGER_ENABLED=false

# ============================================
# TWILIO VERIFY SERVICE CONFIGURATION (OTP via SMS)
# ============================================
# Production-grade OTP system using Twilio Verify
# Setup: https://www.twilio.com/try-twilio (Get free $15 credit)
# 
# Steps to get credentials:
# 1. Create account at https://www.twilio.com/try-twilio
# 2. Go to https://console.twilio.com (copy Account SID & Auth Token)
# 3. Go to https://console.twilio.com/develop/verify/services
# 4. Create Verify Service (or use existing)
# 5. Copy Verify Service SID
#
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_COUNTRY_CODE=+91

# ============================================
# SECURITY NOTES
# ============================================
# 1. Use strong, unique passwords for database
# 2. JWT secret should be at least 256 bits (64 base64 characters)
# 3. Rotate secrets periodically
# 4. Use HTTPS in production
# 5. Consider IP whitelisting in MongoDB Atlas
# 6. Enable MongoDB Atlas audit logs
# 7. Set up monitoring and alerting
# 8. Twilio costs ~₹0.65 ($0.0079) per SMS in production
