# Copy to .env.local (or merge into existing env) to expose the reCAPTCHA site key to Vite
#
# IMPORTANT: create a reCAPTCHA **v2 Checkbox ("I'm not a robot")** key at
# https://www.google.com/recaptcha/admin and paste its SITE KEY below.
# A v3/Enterprise key, or a deleted key, renders "ERROR for site owner:
# Invalid site key" instead of the checkbox. The matching SECRET KEY goes
# to the backend as RECAPTCHA_SECRET (never commit it).
VITE_RECAPTCHA_SITE_KEY=6LcWB8MtAAAAADx_at_Wcs05aAfCup3p5HEM3Pzp
